# =============================================================================
# LinguaAI environment configuration (TEMPLATE)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# =============================================================================

# ---- Database (used by backend and docker-compose mysql service) ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=linguaai
DB_USER=linguaai
DB_PASSWORD=change-me
# Root password for the docker-compose MySQL container (required by compose)
DB_ROOT_PASSWORD=change-me-root

# ---- JWT ----
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-secret
# Minutes until the short-lived access token expires
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=30
# Days until the refresh token expires
JWT_REFRESH_TOKEN_EXPIRY_DAYS=14

# ---- AI provider (server-side only; never ships to the Android app) ----
# mock              -> deterministic offline provider (demo + tests)
# openai-compatible -> any OpenAI-compatible API (OpenAI, DeepSeek, Groq, ...)
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Seconds before an AI request is aborted
AI_TIMEOUT_SECONDS=60
# Max AI chat requests per user per minute (HTTP 429 beyond this)
AI_RATE_LIMIT_PER_MINUTE=20

# ---- Server ----
SERVER_PORT=8080
LOG_LEVEL=INFO

# ---- RAG knowledge base (server-side tutor grounding) ----
# Master switch for retrieval-augmented tutor answers
RAG_ENABLED=true
# Index the course corpus at boot (skipped when RAG_ENABLED=false)
RAG_AUTO_INDEX=true
# Retrieval hits cited per answer
RAG_TOP_K=4
# Vector engine: empty = built-in SQL store; http://qdrant:6333 = Qdrant (compose)
QDRANT_URL=
QDRANT_COLLECTION=linguaai_knowledge
# Host port for the Qdrant dashboard/API when the compose service runs
QDRANT_PORT=6333
# Embedding model for OPENAI_COMPATIBLE providers (mock uses built-in hashing)
AI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Operations endpoints (reindex / seed / stats) ----
# Sent as the X-Ops-Token header. APP_ENV=production refuses to boot if blank.
OPS_TOKEN=linguaai-dev-ops-token
# APP_ENV: leave empty for development. "production" enforces fail-fast
# secrets (JWT_SECRET + OPS_TOKEN must be set, no dev defaults).
APP_ENV=

# Retrieval tuning (optional; defaults shown)
RAG_MAX_CONTEXT_CHARS=2400
RAG_SQL_CANDIDATE_LIMIT=20000

# Mock-provider failure injection for demos/tests (empty = normal replies)
AI_MOCK_SCENARIO=
